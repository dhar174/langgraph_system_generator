# Required for live mode when using the default OpenAI-compatible provider.
OPENAI_API_KEY=your_api_key_here

# Optional provider/tracing credentials.
ANTHROPIC_API_KEY=your_api_key_here
LANGSMITH_API_KEY=your_api_key_here
LANGSMITH_PROJECT=langgraph-notebook-foundry

# Vector Store
VECTOR_STORE_TYPE=faiss
VECTOR_STORE_PATH=./data/vector_store

# Generation Settings
DEFAULT_MODEL=gpt-5-mini
MAX_REPAIR_ATTEMPTS=3
# Reserved setting; currently unenforced in generation (deferred #383).
# Not a per-generation token/spend cap. Keep repair/time/concurrency limits.
DEFAULT_BUDGET_TOKENS=100000

# Logging
LNF_LOG_LEVEL=INFO

# Intake and architecture retrieval tuning.
# JSON arrays/objects are supported for the list/map settings below.
REQUIREMENTS_CONSTRAINT_TYPES=[]
ARCHITECTURE_PATTERN_DOC_QUERIES={}
ARCHITECTURE_PATTERN_DOC_WEIGHTS={}
# Integer cap for weighted docs snippets included in the architecture selector prompt.
ARCHITECTURE_PROMPT_DOC_LIMIT=16
# Maximum concurrent unique query retrievals executed by ArchitectureSelector.
ARCHITECTURE_DOCS_MAX_CONCURRENCY=3

# Internal NotebookComposer tuning and extension hooks.
NOTEBOOK_COMPOSER_DEFAULT_MAX_ITERATIONS=10
NOTEBOOK_COMPOSER_PARALLELISM_MODE=parallel
NOTEBOOK_COMPOSER_MAX_CONCURRENCY=4
NOTEBOOK_COMPOSER_PLUGIN_MODULES=[]

# Internal registry extension hooks. Use JSON arrays or comma-separated modules.
TOOLCHAIN_ENGINEER_PLUGIN_MODULES=[]
GRAPH_DESIGNER_PLUGIN_MODULES=[]
QA_REPAIR_PLUGIN_MODULES=[]
# Optional final-candidate semantic review: exactly off or advisory (default off).
# One call, zero retries, 30s, <=48000 input chars, <=2048 output tokens (or lower request cap).
# Review-call controls only, not a whole-generation token/spend budget; #383 remains deferred.
# Configure separate workers independently. Do not enable hosted runs without owner authorization.
LNF_SPECIALIST_QA_MODE=off

# LLM endpoint trust. Hosted custom providers are disabled by default.
LNF_LLM_ENDPOINT_POLICY=local
LNF_TRUSTED_LLM_ENDPOINTS={}
# LNF_CUSTOM_LLM_API_KEY=<dedicated local-provider credential>
LNF_CUSTOM_LLM_NO_AUTH=false
# Hosted registry values contain only base_url and dedicated LNF_LLM_*_API_KEY names.
# Mount those credentials separately; see docs/llm-endpoint-security.md.

# Runtime/API controls.
LNF_OUTPUT_BASE=.
LNF_MAX_CONCURRENT_GENERATIONS=5
# Cloud Run (K_SERVICE): set only after restricting IAP to trusted operator/admins.
# Ephemeral mode has no per-principal ownership. Durable mode requires iap below.
# LNF_API_ACCESS_MODE=single-operator
# Hosted async defaults off. Local async remains enabled without this setting.
# Enabling hosted async also requires owner-reviewed instance-based CPU billing.
# LNF_EPHEMERAL_ASYNC_ENABLED=false
LNF_JOB_TIMEOUT_SECONDS=240
LNF_MAX_TRACKED_JOBS=100
LNF_MAX_EVENTS_PER_JOB=1000
LNF_MAX_JOB_EVENT_BYTES=262144
LNF_COMPLETED_JOB_TTL_SECONDS=300
LNF_ARTIFACT_TTL_SECONDS=900

# Durable storage remains opt-in; selecting it never falls back to local work.
# Storage selection is separate from API access and LLM endpoint policy.
LNF_JOB_BACKEND=ephemeral
# LNF_JOB_GCP_PROJECT=your-project-id
# LNF_JOB_FIRESTORE_DATABASE=(default)
# LNF_JOB_PROVIDER_REFS=["openai-v1"]
# Mount LNF_JOB_IDEMPOTENCY_SECRET from an owner-managed secret, at least 32 bytes.
# See docs/adr/0002-durable-generation-jobs.md before selecting firestore.

# Separate private worker and maintenance services.
# Review docs/durable-worker.md; these examples do not provision or deploy.
# LNF_JOB_TASK_QUEUE=projects/your-project-id/locations/us-central1/queues/generation
# LNF_WORKER_URL=https://your-private-worker.run.app
# LNF_WORKER_AUDIENCE=https://your-private-worker.run.app
# LNF_TASK_SERVICE_ACCOUNT=tasks-worker@your-project-id.iam.gserviceaccount.com
# LNF_SCHEDULER_SERVICE_ACCOUNT=scheduler@your-project-id.iam.gserviceaccount.com
# LNF_WORKER_OUTPUT_ROOT=./output/worker
# LNF_JOB_ARTIFACT_BUCKET=your-private-artifact-bucket
# LNF_JOB_PROVIDER_BINDINGS={"openai-v1":"openai"}

# B3 owner-scoped API. Default false permits readback/drain but no submissions.
LNF_DURABLE_SUBMISSIONS_ENABLED=false
# LNF_API_ACCESS_MODE=iap
# LNF_IAP_AUDIENCE=/projects/123456/locations/us-central1/services/notebook-api
# Internal service role: worker or maintenance, never user selectable.
# LNF_INTERNAL_SERVICE_ROLE=worker
# LNF_INTERNAL_AUDIENCE=https://your-private-maintenance.run.app
# Admission ledger is shared by ALL API and worker revisions. Pending includes
# queued + running reservations; active limits apply when claiming an attempt.
LNF_JOB_MAX_PENDING=100
LNF_JOB_MAX_ACTIVE=10
LNF_JOB_OWNER_PENDING=5
LNF_JOB_OWNER_ACTIVE=2
# Avoid optional SDK background bucket-metadata RPCs with object-only IAM.
DISABLE_GCS_PYTHON_CLIENT_OTEL_BUCKET_METADATA=true
# Durable retention: events/idempotency 1 day, request/result/objects 7 days.
# Disable parent jobs TTL; authenticated maintenance removes objects/children first.

# Optional live documentation source precedence (Issue #375).
# By default, live sources are disabled and the generator uses cached/local docs.
# DOCS_LIVE_SOURCES_ENABLED=false
# LANGCHAIN_DOCS_MCP_URL=https://docs.langchain.com/mcp
# CONTEXT7_DOCS_ENABLED=false
# CONTEXT7_API_KEY=your_context7_api_key_here
# CONTEXT7_MCP_URL=https://mcp.context7.com/mcp
# DOCS_CONTEXT7_CROSSCHECK=false
# DOCS_SOURCE_PLUGIN_MODULES=[]
# DOCS_MAX_SNIPPET_CHARS=1200
# DOCS_MAX_TOTAL_SNIPPETS=10
