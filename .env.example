# Required for live mode when using the default OpenAI-compatible provider.
OPENAI_API_KEY=your_api_key_here

# Optional provider/tracing credentials.
ANTHROPIC_API_KEY=your_api_key_here
LANGSMITH_API_KEY=your_api_key_here
LANGSMITH_PROJECT=langgraph-notebook-foundry

# Vector Store
VECTOR_STORE_TYPE=faiss
VECTOR_STORE_PATH=./data/vector_store

# Generation Settings
DEFAULT_MODEL=gpt-5-mini
MAX_REPAIR_ATTEMPTS=3
DEFAULT_BUDGET_TOKENS=100000

# Logging
LNF_LOG_LEVEL=INFO

# Intake and architecture retrieval tuning.
# JSON arrays/objects are supported for these settings.
REQUIREMENTS_CONSTRAINT_TYPES=[]
ARCHITECTURE_PATTERN_DOC_QUERIES={}
ARCHITECTURE_PATTERN_DOC_WEIGHTS={}
ARCHITECTURE_PROMPT_DOC_LIMIT=16

# Internal NotebookComposer tuning and extension hooks.
NOTEBOOK_COMPOSER_DEFAULT_MAX_ITERATIONS=10
NOTEBOOK_COMPOSER_PARALLELISM_MODE=parallel
NOTEBOOK_COMPOSER_MAX_CONCURRENCY=4
NOTEBOOK_COMPOSER_PLUGIN_MODULES=[]

# Internal registry extension hooks. Use JSON arrays or comma-separated modules.
TOOLCHAIN_ENGINEER_PLUGIN_MODULES=[]
GRAPH_DESIGNER_PLUGIN_MODULES=[]
QA_REPAIR_PLUGIN_MODULES=[]

# Runtime/API controls.
LNF_OUTPUT_BASE=.
LNF_MAX_CONCURRENT_GENERATIONS=5
