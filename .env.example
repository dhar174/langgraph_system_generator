# Required for live mode when using the default OpenAI-compatible provider.
OPENAI_API_KEY=your_api_key_here

# Optional provider/tracing credentials.
ANTHROPIC_API_KEY=your_api_key_here
LANGSMITH_API_KEY=your_api_key_here
LANGSMITH_PROJECT=langgraph-notebook-foundry

# Vector Store
VECTOR_STORE_TYPE=faiss
VECTOR_STORE_PATH=./data/vector_store

# Generation Settings
DEFAULT_MODEL=gpt-5-mini
MAX_REPAIR_ATTEMPTS=3
DEFAULT_BUDGET_TOKENS=100000

# Logging
LNF_LOG_LEVEL=INFO

# Intake and architecture retrieval tuning.
# JSON arrays/objects are supported for the list/map settings below.
REQUIREMENTS_CONSTRAINT_TYPES=[]
ARCHITECTURE_PATTERN_DOC_QUERIES={}
ARCHITECTURE_PATTERN_DOC_WEIGHTS={}
# Integer cap for weighted docs snippets included in the architecture selector prompt.
ARCHITECTURE_PROMPT_DOC_LIMIT=16
# Maximum concurrent unique query retrievals executed by ArchitectureSelector.
ARCHITECTURE_DOCS_MAX_CONCURRENCY=3

# Internal NotebookComposer tuning and extension hooks.
NOTEBOOK_COMPOSER_DEFAULT_MAX_ITERATIONS=10
NOTEBOOK_COMPOSER_PARALLELISM_MODE=parallel
NOTEBOOK_COMPOSER_MAX_CONCURRENCY=4
NOTEBOOK_COMPOSER_PLUGIN_MODULES=[]

# Internal registry extension hooks. Use JSON arrays or comma-separated modules.
TOOLCHAIN_ENGINEER_PLUGIN_MODULES=[]
GRAPH_DESIGNER_PLUGIN_MODULES=[]
QA_REPAIR_PLUGIN_MODULES=[]

# LLM endpoint trust. Hosted custom providers are disabled by default.
LNF_LLM_ENDPOINT_POLICY=local
LNF_TRUSTED_LLM_ENDPOINTS={}
# LNF_CUSTOM_LLM_API_KEY=<dedicated local-provider credential>
LNF_CUSTOM_LLM_NO_AUTH=false
# Hosted registry values contain only base_url and dedicated LNF_LLM_*_API_KEY names.
# Mount those credentials separately; see docs/llm-endpoint-security.md.

# Runtime/API controls.
LNF_OUTPUT_BASE=.
LNF_MAX_CONCURRENT_GENERATIONS=5
# Cloud Run (K_SERVICE): set only after restricting IAP to trusted operator/admins.
# No per-principal ownership is implemented. Unsupported multi-user mode fails closed.
# LNF_API_ACCESS_MODE=single-operator
# Hosted async defaults off. Local async remains enabled without this setting.
# Enabling hosted async also requires owner-reviewed instance-based CPU billing.
# LNF_EPHEMERAL_ASYNC_ENABLED=false
LNF_JOB_TIMEOUT_SECONDS=240
LNF_MAX_TRACKED_JOBS=100
LNF_MAX_EVENTS_PER_JOB=1000
LNF_MAX_JOB_EVENT_BYTES=262144
LNF_COMPLETED_JOB_TTL_SECONDS=300
LNF_ARTIFACT_TTL_SECONDS=900

# Optional live documentation source precedence (Issue #375).
# By default, live sources are disabled and the generator uses cached/local docs.
# DOCS_LIVE_SOURCES_ENABLED=false
# LANGCHAIN_DOCS_MCP_URL=https://docs.langchain.com/mcp
# CONTEXT7_DOCS_ENABLED=false
# CONTEXT7_API_KEY=your_context7_api_key_here
# CONTEXT7_MCP_URL=https://mcp.context7.com/mcp
# DOCS_CONTEXT7_CROSSCHECK=false
# DOCS_SOURCE_PLUGIN_MODULES=[]
# DOCS_MAX_SNIPPET_CHARS=1200
# DOCS_MAX_TOTAL_SNIPPETS=10
